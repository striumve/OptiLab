# Copy to .env or configure the key in application settings.
# Never put API keys in VITE_* variables.
AI_API_KEY=
PORT=5180
# Optional overrides (the default is DeepSeek Responses; application settings take precedence).
# AI_PROVIDER=DeepSeek
# AI_BASE_URL=https://api.deepseek.com
# AI_PROTOCOL=responses
# AI_MODEL=deepseek-flash
# For a custom provider, set the URL, protocol and model together:
# AI_PROVIDER=Custom
# AI_BASE_URL=https://your-provider.example/v1
# AI_PROTOCOL=chat-completions
# AI_MODEL=your-model-id
